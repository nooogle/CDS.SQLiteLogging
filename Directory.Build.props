<Project>

  <!-- NuGet audit: high/critical advisories break the build in CI only, so a
       new advisory published mid-session never blocks local work. -->
  <PropertyGroup>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors Condition="'$(CI)' == 'true'">$(WarningsAsErrors);NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>
  <PropertyGroup>
    <Authors>Jon Shadforth</Authors>
    <Company>Carpe Diem Systems</Company>
    <Copyright>Copyright (c) 2025 Carpe Diem Systems</Copyright>
    <!-- MinVer reads the version from the nearest Git tag (e.g. v2.5.0).
         If no tag is found it falls back to MinVerMinimumMajorMinor. -->
    <MinVerTagPrefix>V</MinVerTagPrefix>
    <MinVerMinimumMajorMinor>2.5</MinVerMinimumMajorMinor>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" Version="8.0.0" PrivateAssets="all">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
